ROOOM_LISTEN=:9090
ROOOM_WAL_DIR=./data
ROOOM_RETENTION=360h
ROOOM_SHARDS=128
ROOOM_CARDINALITY_LIMIT=1000000
# Static Prometheus scrape targets, comma separated.
ROOOM_SCRAPE_TARGETS=http://localhost:9100/metrics
ROOOM_SCRAPE_INTERVAL=15s
ROOOM_SCRAPE_TENANT=default
# Cluster peers. Each node can replicate writes and fan out queries to peers.
ROOOM_PEERS=http://metrics-2:9090,http://metrics-3:9090
ROOOM_REPLICATION_FACTOR=2
